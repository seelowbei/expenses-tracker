{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --test-scheduled",
    "bundle": "mkdir -p ../web/dist && wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply expense-local --local"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "oauth4webapi": "3.8.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "4.1.12",
    "drizzle-kit": "0.31.11",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
