# Template for worker/.env (git-ignored). Copy and fill in:
#   cp worker/.env.sample worker/.env
#
# Read by the Wrangler CLI itself (auth for `pnpm --filter worker dev` and the M1 eval).
# Never deployed. Staging/production config lives in Pulumi (see infrastructure/README.md).

# Cloudflare DEV token "expense-tracker-dev" (Workers AI Read + Edit, Workers Scripts Edit,
# Account Settings Read). Never the provisioning token. See README "Cloudflare tokens".
CLOUDFLARE_API_TOKEN=

# Optional: already set as account_id in wrangler.jsonc.
# CLOUDFLARE_ACCOUNT_ID=10640769d8415d865c5f386b850d0ef5

# Wrangler also loads .env into the local Worker's bindings when no .dev.vars exists.
# Keep this so the token above is never exposed to the Worker as env.CLOUDFLARE_API_TOKEN.
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false
