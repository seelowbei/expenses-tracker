{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm -r test:*)",
      "Bash(pnpm --filter web build:*)",
      "Bash(pnpm --filter web test:*)",
      "Bash(pnpm --filter worker test:*)",
      "Bash(pnpm --filter worker exec tsc:*)",
      "Bash(pnpm --filter worker exec wrangler types:*)",
      "Bash(pnpm --filter worker types)",
      "Bash(pnpm --filter worker typecheck)",
      "Bash(pnpm --filter worker bundle)",
      "Bash(pnpm --filter worker exec wrangler d1 migrations apply expense-local --local:*)",
      "Bash(pnpm --filter worker exec wrangler d1 migrations list:*)",
      "Bash(pnpm --filter worker exec drizzle-kit generate:*)",
      "Bash(pnpm --filter \"./infrastructure/*\" typecheck)",
      "Bash(pulumi preview:*)",
      "Bash(pulumi stack ls:*)",
      "Bash(pulumi stack output:*)",
      "Bash(pulumi config get:*)"
    ],
    "deny": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler d1 time-travel*)",
      "Bash(*--remote*)",
      "Bash(*pulumi up*)",
      "Bash(*pulumi destroy*)",
      "Bash(*pulumi refresh*)",
      "Bash(*pulumi state*)",
      "Bash(*pulumi import*)",
      "Bash(*pulumi cancel*)",
      "Bash(*pulumi stack rm*)",
      "Bash(*pulumi stack init*)",
      "Bash(*pulumi config set*)",
      "Bash(*pulumi config rm*)",
      "Bash(*--show-secrets*)",
      "Read(./worker/.dev.vars)",
      "Read(./**/.dev.vars)",
      "Edit(./**/.dev.vars)",
      "Read(./**/.dev.vars.local)",
      "Edit(./**/.dev.vars.local)",
      "Read(./**/.dev.vars.staging)",
      "Edit(./**/.dev.vars.staging)",
      "Read(./**/.dev.vars.production)",
      "Edit(./**/.dev.vars.production)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Edit(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Edit(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Edit(./**/.env.production)",
      "Read(./**/.env.test)",
      "Edit(./**/.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-secrets.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
